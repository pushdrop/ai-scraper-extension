{
  "manifest_version": 3,
  "name": "Smart Copy Page",
  "version": "1.0.0",
  "description": "Copy useful structured data from any webpage with AI.",
  "action": {
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"]
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite"
  ]
}
